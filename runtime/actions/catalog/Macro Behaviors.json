  "schema_version": "1.0",
  "chapter": {
    "id": "behavior.macro",
    "title": "Macro Behaviors",
    "documentation_url": "https://aressc2.github.io/ares-sc2/api_reference/behaviors/macro_behaviors.html"
  },
  "source": {
    "ares_version": "3.9.6",
    "git_commit": "0ac34b87f9471979f8de19a77020eed2d8693b26"
  },
  "entries": [
    {
      "id": "macro.addon_swap",
      "name": "AddonSwap",
      "description": "Attach the requested add-on by swapping structures.",
      "tags": [
        "technology",
        "production"
      ],
      "availability": {
        "param": "structure_needing_addon",
        "types": [
          "BARRACKS",
          "FACTORY",
          "STARPORT"
        ]
      },
      "api": {
        "import": "ares.behaviors.macro.addon_swap.AddonSwap",
        "source_path": "ares-sc2/src/ares/behaviors/macro/addon_swap.py"
      },
      "params": [
        {
          "name": "structure_needing_addon",
          "type": "unit_or_unit_type_id",
          "input": "model",
          "required": true,
          "options": [
            "BARRACKS",
            "FACTORY",
            "STARPORT"
          ],
          "description": "Structure or type needing the add-on."
        },
        {
          "name": "addon_required",
          "type": "unit_type_id",
          "input": "model",
          "required": true,
          "options": [
            "BARRACKSREACTOR",
            "BARRACKSTECHLAB",
            "FACTORYREACTOR",
            "FACTORYTECHLAB",
            "REACTOR",
            "STARPORTREACTOR",
            "STARPORTTECHLAB",
            "TECHLAB"
          ],
          "description": "Required Tech Lab or Reactor."
        },
        {
          "name": "precise_addon_structure_id",
          "type": "unit_type_id",
          "input": "model",
          "required": false,
          "options": [
            "BARRACKSREACTOR",
            "BARRACKSTECHLAB",
            "FACTORYREACTOR",
            "FACTORYTECHLAB",
            "STARPORTREACTOR",
            "STARPORTTECHLAB"
          ],
          "description": "Precise addon structure id.",
          "default": null
        }
      ],
      "llm_exposure": "eligible"
    },
    {
      "id": "macro.auto_supply",
      "name": "AutoSupply",
      "description": "Build supply when low.",
      "tags": [
        "resource",
        "supply"
      ],
      "availability": {
        "param": null,
        "types": [
          "ALL"
        ]
      },
      "api": {
        "import": "ares.behaviors.macro.auto_supply.AutoSupply",
        "source_path": "ares-sc2/src/ares/behaviors/macro/auto_supply.py"
      },
      "params": [
        {
          "name": "base_location",
          "type": "point_ref",
          "input": "model",
          "required": true,
          "description": "Supply build location."
        },
        {
          "name": "return_true_if_supply_required",
          "type": "boolean",
          "input": "model",
          "required": false,
          "description": "If supply can't be afforded but is required, return true. Useful for creating a `MacroPlan`.",
          "default": true
        },
        {
          "name": "closest_to",
          "type": "point_ref",
          "input": "model",
          "required": false,
          "description": "Find available supply placement closest to this location. Only applicable to Terran or Protoss.",
          "default": null
        }
      ],
      "llm_exposure": "disabled"
    },
    {
      "id": "macro.build_structure",
      "name": "BuildStructure",
      "description": "Build near a base. Use GasBuildingController for gas and TechUp for add-ons.",
      "tags": [
        "technology",
        "construction"
      ],
      "availability": {
        "param": null,
        "types": [
          "SCV",
          "DRONE",
          "PROBE"
        ]
      },
      "api": {
        "import": "ares.behaviors.macro.build_structure.BuildStructure",
        "source_path": "ares-sc2/src/ares/behaviors/macro/build_structure.py"
      },
      "params": [
        {
          "name": "base_location",
          "type": "point_ref",
          "input": "model",
          "required": true,
          "description": "The base location to build near."
        },
        {
          "name": "structure_id",
          "type": "unit_type_id",
          "input": "model",
          "required": true,
          "options": [
            "ARMORY",
            "BANELINGNEST",
            "BARRACKS",
            "BUNKER",
            "COMMANDCENTER",
            "CYBERNETICSCORE",
            "DARKSHRINE",
            "ENGINEERINGBAY",
            "EVOLUTIONCHAMBER",
            "FACTORY",
            "FLEETBEACON",
            "FORGE",
            "FUSIONCORE",
            "GATEWAY",
            "GHOSTACADEMY",
            "HATCHERY",
            "HYDRALISKDEN",
            "INFESTATIONPIT",
            "LURKERDENMP",
            "MISSILETURRET",
            "NEXUS",
            "NYDUSCANAL",
            "NYDUSNETWORK",
            "PHOTONCANNON",
            "PYLON",
            "ROACHWARREN",
            "ROBOTICSBAY",
            "ROBOTICSFACILITY",
            "SENSORTOWER",
            "SHIELDBATTERY",
            "SPAWNINGPOOL",
            "SPINECRAWLER",
            "SPIRE",
            "SPORECRAWLER",
            "STARGATE",
            "STARPORT",
            "SUPPLYDEPOT",
            "TEMPLARARCHIVE",
            "TWILIGHTCOUNCIL",
            "ULTRALISKCAVERN"
          ],
          "description": "Structure type to build."
        },
        {
          "name": "max_on_route",
          "type": "integer",
          "input": "model",
          "required": false,
          "description": "The max number of workers on route to build this. Defaults to 1.",
          "default": 1
        },
        {
          "name": "first_pylon",
          "type": "boolean",
          "input": "model",
          "required": false,
          "description": "Will look for the first pylon in placements dict. Defaults to False.",
          "default": false
        },
        {
          "name": "static_defence",
          "type": "boolean",
          "input": "model",
          "required": false,
          "description": "Will look for static defense in placements dict. Defaults to False.",
          "default": false
        },
        {
          "name": "wall",
          "type": "boolean",
          "input": "model",
          "required": false,
          "description": "Find wall placement if possible. Only the main base is currently supported. Defaults to False.",
          "default": false
        },
        {
          "name": "closest_to",
          "type": "point_ref",
          "input": "model",
          "required": false,
          "description": "Find placement at this base closest to the given point. Optional.",
          "default": null
        },
        {
          "name": "to_count",
          "type": "integer",
          "input": "model",
          "required": false,
          "description": "Prevent going over this amount in total. Defaults to 0, turning this check off.",
          "default": 0
        },
        {
          "name": "to_count_per_base",
          "type": "integer",
          "input": "model",
          "required": false,
          "description": "Prevent going over this amount at this base location. Defaults to 0, turning this check off.",
          "default": 0
        },
        {
          "name": "tech_progress_check",
          "type": "number",
          "input": "model",
          "required": false,
          "description": "Check if tech is ready before trying to build. Defaults to 0.85; setting it to 0.0 turns this check off.",
          "default": 0.85
        },
        {
          "name": "supply_depot",
          "type": "boolean",
          "input": "model",
          "required": false,
          "description": "Choose a predefined supply depot location. Defaults to False.",
          "default": false
        },
        {
          "name": "missile_turret",
          "type": "boolean",
          "input": "model",
          "required": false,
          "description": "Choose a predefined missile turret location. Defaults to False.",
          "default": false
        },
        {
          "name": "sensor_tower",
          "type": "boolean",
          "input": "model",
          "required": false,
          "description": "Choose a predefined sensor tower location. Defaults to False.",
          "default": false
        },
        {
          "name": "upgrade_structure",
          "type": "boolean",
          "input": "model",
          "required": false,
          "description": "Choose a predefined upgrade-structure location. Defaults to False.",
          "default": false
        },
        {
          "name": "production",
          "type": "boolean",
          "input": "model",
          "required": false,
          "description": "Choose a predefined production location. Defaults to True.",
          "default": true
        },
        {
          "name": "bunker",
          "type": "boolean",
          "input": "model",
          "required": false,
          "description": "Choose a predefined bunker location. Defaults to False.",
          "default": false
        },
        {
          "name": "reaper_wall",
          "type": "boolean",
          "input": "model",
          "required": false,
          "description": "Choose a predefined reaper wall location. Defaults to False.",
          "default": false
        },
        {
          "name": "find_alternative",
          "type": "boolean",
          "input": "model",
          "required": false,
          "description": "If no placements are available at this base, optionally search nearby bases. Defaults to True.",
          "default": true
        }
      ],
      "llm_exposure": "eligible"
    },
    {
      "id": "macro.build_workers",
      "name": "BuildWorkers",
      "description": "Train SCVs until the requested total SCV count is reached.",
      "tags": [
        "resource",
        "production"
      ],
      "availability": {
        "param": null,
        "types": [
          "COMMANDCENTER",
          "ORBITALCOMMAND",
          "PLANETARYFORTRESS",
          "NEXUS",
          "HATCHERY",
          "LAIR",
          "HIVE"
        ]
      },
      "api": {
        "import": "ares.behaviors.macro.build_workers.BuildWorkers",
        "source_path": "ares-sc2/src/ares/behaviors/macro/build_workers.py"
      },
      "params": [
        {
          "name": "to_count",
          "type": "integer",
          "input": "model",
          "required": true,
          "description": "Desired total worker count."
        }
      ],
      "llm_exposure": "eligible"
    },
    {
      "id": "macro.expansion_controller",
      "name": "ExpansionController",
      "description": "Expand until the requested total base count is reached.",
      "tags": [
        "resource",
        "expansion"
      ],
      "availability": {
        "param": null,
        "types": [
          "SCV",
          "DRONE",
          "PROBE"
        ]
      },
      "api": {
        "import": "ares.behaviors.macro.expansion_controller.ExpansionController",
        "source_path": "ares-sc2/src/ares/behaviors/macro/expansion_controller.py"
      },
      "params": [
        {
          "name": "to_count",
          "type": "integer",
          "input": "model",
          "required": true,
          "description": "Desired total base count."
        },
        {
          "name": "can_afford_check",
          "type": "boolean",
          "input": "model",
          "required": false,
          "description": "Check if we can afford expansion. Setting this to False will allow the worker to move to a location ready to build the expansion. Defaults to True.",
          "default": true
        },
        {
          "name": "check_location_is_safe",
          "type": "boolean",
          "input": "model",
          "required": false,
          "description": "Check if we don't knowingly expand at a dangerous location. Defaults to True.",
          "default": true
        },
        {
          "name": "max_pending",
          "type": "integer",
          "input": "model",
          "required": false,
          "description": "Maximum pending townhalls at any time. Defaults to 1.",
          "default": 1
        },
        {
          "name": "prioritize",
          "type": "boolean",
          "input": "model",
          "required": false,
          "description": "Will return True for this behavior if we can't afford expansion. Default is False",
          "default": false
        }
      ],
      "llm_exposure": "eligible"
    },
    {
      "id": "macro.gas_building_controller",
      "name": "GasBuildingController",
      "description": "Maintain the requested number of Refineries.",
      "tags": [
        "resource"
      ],
      "availability": {
        "param": null,
        "types": [
          "SCV",
          "DRONE",
          "PROBE"
        ]
      },
      "api": {
        "import": "ares.behaviors.macro.gas_building_controller.GasBuildingController",
        "source_path": "ares-sc2/src/ares/behaviors/macro/gas_building_controller.py"
      },
      "params": [
        {
          "name": "to_count",
          "type": "integer",
          "input": "model",
          "required": true,
          "description": "Desired total gas structure count."
        },
        {
          "name": "max_pending",
          "type": "integer",
          "input": "model",
          "required": false,
          "description": "How many gas buildings can be pending at any time? Defaults to 1.",
          "default": 1
        },
        {
          "name": "closest_to",
          "type": "point_ref",
          "input": "model",
          "required": false,
          "description": "Find available geyser closest to this location. Optional, defaults to `None`",
          "default": null
        }
      ],
      "llm_exposure": "eligible"
    },
    {
      "id": "macro.macro_plan",
      "name": "MacroPlan",
      "description": "Try macro behaviors in order until one acts.",
      "tags": [
        "macro"
      ],
      "availability": {
        "param": null,
        "types": [
          "ALL"
        ]
      },
      "api": {
        "import": "ares.behaviors.macro.macro_plan.MacroPlan",
        "source_path": "ares-sc2/src/ares/behaviors/macro/macro_plan.py"
      },
      "params": [
        {
          "name": "macros",
          "type": "json_array",
          "input": "derived",
          "required": false,
          "description": "A list of behaviors that should be executed. Defaults to an empty list.",
          "default": {
            "expression": "field(default_factory=list)"
          }
        }
      ],
      "llm_exposure": "disabled"
    },
    {
      "id": "macro.mining",
      "name": "Mining",
      "description": "Manage worker mining and safety.",
      "tags": [
        "resource"
      ],
      "availability": {
        "param": null,
        "types": [
          "SCV",
          "DRONE",
          "PROBE"
        ]
      },
      "api": {
        "import": "ares.behaviors.macro.mining.Mining",
        "source_path": "ares-sc2/src/ares/behaviors/macro/mining.py"
      },
      "params": [
        {
          "name": "flee_at_health_perc",
          "type": "number",
          "input": "model",
          "required": false,
          "description": "If worker is in danger, at what health percentage should it flee? Defaults to 0.5.",
          "default": 0.5
        },
        {
          "name": "keep_safe",
          "type": "boolean",
          "input": "model",
          "required": false,
          "description": "Should workers flee if they are in danger? Defaults to True.",
          "default": true
        },
        {
          "name": "long_distance_mine",
          "type": "boolean",
          "input": "model",
          "required": false,
          "description": "Can the worker long distance mine if it has nothing to do? Defaults to True.",
          "default": true
        },
        {
          "name": "mineral_boost",
          "type": "boolean",
          "input": "model",
          "required": false,
          "description": "Turn mineral boosting on or off. Defaults to True.",
          "default": true
        },
        {
          "name": "vespene_boost",
          "type": "boolean",
          "input": "model",
          "required": false,
          "description": "Turn vespene boosting on or off (only active when workers_per_gas < 3).",
          "default": false
        },
        {
          "name": "workers_per_gas",
          "type": "integer",
          "input": "model",
          "required": false,
          "description": "Control how many workers are assigned to each gas. Defaults to 3.",
          "default": 3
        },
        {
          "name": "self_defence_active",
          "type": "boolean",
          "input": "model",
          "required": false,
          "description": "If set to True, workers will have some basic defence. Certain workers will attack enemy in range. Defaults to True.",
          "default": true
        },
        {
          "name": "safe_long_distance_mineral_fields",
          "type": "unit_refs",
          "input": "model",
          "required": false,
          "description": "Used internally, set when a worker starts long distance mining. Defaults to None.",
          "default": null
        },
        {
          "name": "locked_action_tags",
          "type": "json_object",
          "input": "model",
          "required": false,
          "description": "Locked action tags.",
          "default": {
            "expression": "field(default_factory=dict)"
          }
        },
        {
          "name": "weight_safety_limit",
          "type": "number",
          "input": "model",
          "required": false,
          "description": "Workers will flee if enemy influence is above this number. Defaults to 12.0",
          "default": 12.0
        }
      ],
      "llm_exposure": "disabled"
    },
    {
      "id": "macro.production_controller",
      "name": "ProductionController",
