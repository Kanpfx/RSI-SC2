          "name": "add_production_at_bank",
          "type": "resource_pair",
          "input": "model",
          "required": false,
          "description": "When the bank reaches this size, calculate what extra production would be useful. Tuple: minerals, then vespene. Defaults to `(400, 400)`.",
          "default": [
            400,
            400
          ]
        },
        {
          "name": "alpha",
          "type": "number",
          "input": "model",
          "required": false,
          "description": "Controls how much production to add when the bank is higher than `add_production_at_bank`. Defaults to `0.9`.",
