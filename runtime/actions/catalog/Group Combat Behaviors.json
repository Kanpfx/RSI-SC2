  "entries": [
    {
      "id": "combat.group.a_move_group",
      "name": "AMoveGroup",
      "description": "Attack-move a group toward a target.",
      "tags": [
        "combat",
        "movement"
      ],
      "availability": {
        "param": "group",
        "types": [
          "ALL"
        ]
      },
      "api": {
        "import": "ares.behaviors.combat.group.a_move_group.AMoveGroup",
        "source_path": "ares-sc2/src/ares/behaviors/combat/group/a_move_group.py"
      },
      "params": [
        {
          "name": "group",
          "type": "unit_refs",
          "input": "model",
          "required": true,
          "description": "Units we want to control."
        },
        {
          "name": "group_tags",
          "type": "integer_list",
          "input": "derived",
          "required": true,
          "description": "The group unit tags.",
          "derive": "group_tags"
        },
        {
          "name": "target",
          "type": "point_or_unit_ref",
          "input": "model",
          "required": true,
          "description": "Attack-move target."
        }
      ],
      "llm_exposure": "eligible"
    },
    {
      "id": "combat.group.group_use_ability",
      "name": "GroupUseAbility",
      "description": "Use one ability with a group of units.",
      "tags": [
        "combat",
        "ability"
      ],
      "availability": {
        "param": "group",
        "types": [
          "ALL"
        ]
      },
      "api": {
        "import": "ares.behaviors.combat.group.group_use_ability.GroupUseAbility",
        "source_path": "ares-sc2/src/ares/behaviors/combat/group/group_use_ability.py"
      },
      "params": [
        {
          "name": "ability",
          "type": "ability_id",
          "input": "model",
          "required": true,
          "description": "Ability to use."
        },
        {
          "name": "group",
          "type": "unit_refs",
          "input": "model",
          "required": true,
          "description": "Units we want to control."
        },
        {
          "name": "group_tags",
          "type": "integer_list",
          "input": "derived",
          "required": true,
          "description": "The group unit tags.",
          "derive": "group_tags"
        },
        {
          "name": "target",
          "type": "point_or_unit_ref",
          "input": "model",
          "required": true,
          "description": "Ability target.",
          "nullable": true
        },
        {
          "name": "sync_command",
          "type": "boolean",
          "input": "model",
          "required": false,
          "description": "(default=True) If True, wait for all units to be ready before trying ability.",
          "default": true
        }
      ],
      "llm_exposure": "eligible"
    },
    {
      "id": "combat.group.keep_group_safe",
      "name": "KeepGroupSafe",
      "description": "Avoid danger; attack when safe. close_enemy may be [].",
      "tags": [
        "combat",
        "defense"
      ],
      "availability": {
        "param": "group",
        "types": [
          "ALL"
        ]
      },
      "api": {
        "import": "ares.behaviors.combat.group.keep_group_safe.KeepGroupSafe",
        "source_path": "ares-sc2/src/ares/behaviors/combat/group/keep_group_safe.py"
      },
      "params": [
        {
          "name": "group",
          "type": "unit_refs",
          "input": "model",
          "required": true,
          "description": "Units we want to control."
        },
        {
          "name": "close_enemy",
          "type": "unit_refs",
          "input": "model",
          "required": true,
          "description": "Nearby enemies."
        },
        {
          "name": "grid",
          "type": "grid_ref",
          "input": "model",
          "required": true,
          "description": "Safety grid."
        },
        {
          "name": "attack_in_range_enemy",
          "type": "boolean",
          "input": "model",
          "required": false,
          "description": "Whether to attack in range if weapon is ready. Defaults to True.",
          "default": true
        }
      ],
      "llm_exposure": "eligible"
    },
    {
      "id": "combat.group.path_group_to_target",
      "name": "PathGroupToTarget",
      "description": "Path a group toward a target.",
      "tags": [
        "combat",
        "movement"
      ],
      "availability": {
        "param": "group",
        "types": [
          "ALL"
        ]
      },
      "api": {
        "import": "ares.behaviors.combat.group.path_group_to_target.PathGroupToTarget",
        "source_path": "ares-sc2/src/ares/behaviors/combat/group/path_group_to_target.py"
      },
      "params": [
        {
          "name": "start",
          "type": "point_ref",
          "input": "derived",
          "required": true,
          "description": "Path starting point.",
          "derive": "group_center"
        },
        {
          "name": "group",
          "type": "unit_refs",
          "input": "model",
          "required": true,
          "description": "Units to move."
        },
        {
          "name": "group_tags",
          "type": "integer_list",
          "input": "derived",
          "required": true,
          "description": "Unit tags.",
          "derive": "group_tags"
        },
        {
          "name": "grid",
          "type": "grid_ref",
          "input": "model",
          "required": true,
          "description": "Pathing grid."
        },
        {
          "name": "target",
          "type": "point_ref",
          "input": "model",
          "required": true,
          "description": "Target destination."
        },
        {
          "name": "distance_check_squared",
          "type": "number",
          "input": "model",
          "required": false,
          "description": "Distance check squared.",
          "default": 26.25
        },
        {
          "name": "success_at_distance",
          "type": "number",
          "input": "model",
          "required": false,
          "description": "If the group's supplied start position is this close to the target, do not issue a pathing command. Defaults to 0.0.",
          "default": 0.0
        },
        {
          "name": "sensitivity",
          "type": "integer",
          "input": "model",
          "required": false,
          "description": "Pathfinding precision. Defaults to 12.",
          "default": 12
        },
        {
          "name": "smoothing",
          "type": "boolean",
          "input": "model",
          "required": false,
          "description": "Whether to smooth out the path. Defaults to False.",
          "default": false
        },
        {
          "name": "sense_danger",
          "type": "boolean",
          "input": "model",
          "required": false,
          "description": "Whether to check for dangers. If none are present, the pathing query is skipped. Defaults to False.",
          "default": false
        },
        {
          "name": "danger_distance",
          "type": "number",
          "input": "model",
          "required": false,
          "description": "If `sense_danger` is True, how far to check for dangers. Defaults to 20.0.",
          "default": 20.0
        },
        {
          "name": "danger_threshold",
          "type": "number",
          "input": "model",
          "required": false,
          "description": "Influence at which a danger is respected. Defaults to 5.0.",
          "default": 5.0
        },
        {
          "name": "prevent_duplicate",
          "type": "boolean",
          "input": "model",
          "required": false,
          "description": "Whether to try to prevent spamming actions. Defaults to True.",
          "default": true
        }
      ],
      "llm_exposure": "eligible"
    },
    {
