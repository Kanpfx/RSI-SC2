        },
        {
          "name": "group_tags",
          "type": "integer_list",
          "input": "derived",
          "required": true,
          "description": "The group unit tags.",
          "derive": "group_tags"
        },
        {
          "name": "group_position",
          "type": "point_ref",
          "input": "derived",
          "required": true,
          "description": "Current group center.",
          "derive": "group_center"
        },
        {
          "name": "target",
          "type": "point_or_unit_ref",
          "input": "model",
          "required": true,
          "description": "Engagement target."
        },
        {
          "name": "grid",
          "type": "grid_ref",
          "input": "model",
          "required": true,
          "description": "Retreat safety grid."
        }
      ],
      "llm_exposure": "eligible"
    },
    {
      "id": "combat.group.stutter_group_forward",
      "name": "StutterGroupForward",
      "description": "Attack when ready; advance the group during cooldown.",
      "tags": [
        "combat",
        "movement"
      ],
      "availability": {
        "param": "group",
        "types": [
          "ALL"
        ]
      },
      "api": {
        "import": "ares.behaviors.combat.group.stutter_group_forward.StutterGroupForward",
        "source_path": "ares-sc2/src/ares/behaviors/combat/group/stutter_group_forward.py"
      },
      "params": [
        {
          "name": "group",
          "type": "unit_refs",
          "input": "model",
          "required": true,
          "description": "The group of units we want to control."
        },
        {
          "name": "group_tags",
          "type": "integer_list",
          "input": "derived",
          "required": true,
          "description": "The group unit tags.",
          "derive": "group_tags"
        },
        {
          "name": "group_position",
          "type": "point_ref",
          "input": "derived",
          "required": true,
          "description": "Compatibility-only; currently ignored.",
          "derive": "group_center"
        },
        {
          "name": "target",
          "type": "point_or_unit_ref",
          "input": "model",
          "required": true,
          "description": "Coordination target; requires `enemies`.",
          "prompt_detail": true
        },
        {
          "name": "enemies",
          "type": "unit_refs",
